# Token Vercel Blob (otomatis tersedia setelah Blob store dihubungkan ke proyek Vercel).
BLOB_READ_WRITE_TOKEN=

# Hash scrypt kata sandi dasbor peneliti: node scripts/hash-password.mts "kata sandi"
RESEARCHER_PASSWORD_HASH=

# Hanya lokal: kata sandi teks biasa (diabaikan di produksi).
# RESEARCHER_PASSWORD=

# Kunci enkripsi jawaban (32 byte, base64). Simpan cadangannya; tanpa kunci ini data tidak dapat dibaca.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Kunci penanda tangan cookie sesi peneliti. Minimal 32 karakter acak.
SESSION_SECRET=

# Opsional: alamat surel kontak peneliti yang ditampilkan pada halaman informasi.
CONTACT_EMAIL=

# Opsional (hanya lokal): simpan jawaban ke folder .data/ saat menjalankan `next start`.
# LOCAL_RESPONSE_STORE=1
