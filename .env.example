# Token Vercel Blob (otomatis tersedia setelah Blob store dihubungkan ke proyek Vercel).
BLOB_READ_WRITE_TOKEN=

# Kata sandi dasbor peneliti di /peneliti. Minimal 12 karakter.
RESEARCHER_PASSWORD=

# Kunci penanda tangan cookie sesi peneliti. Minimal 32 karakter acak.
SESSION_SECRET=

# Opsional: alamat surel kontak peneliti yang ditampilkan pada halaman informasi.
CONTACT_EMAIL=

# Opsional (hanya lokal): simpan jawaban ke folder .data/ saat menjalankan `next start`.
# LOCAL_RESPONSE_STORE=1
